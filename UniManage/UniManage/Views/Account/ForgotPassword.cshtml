@model UniManage.ViewModels.ForgotPasswordViewModel
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm no-hover-card"><div class="card-body">
            <h4>Forgot Password</h4>
            <form method="post">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })
                <div class="mb-3">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })</div>
                <button class="btn btn-modern">Send OTP</button>
            </form>
        </div></div>
    </div>
</div>
@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
