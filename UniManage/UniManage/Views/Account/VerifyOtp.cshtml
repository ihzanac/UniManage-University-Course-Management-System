@model UniManage.ViewModels.VerifyOtpViewModel
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm no-hover-card"><div class="card-body">
            <h4>Verify OTP</h4>
            <form method="post">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)
                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })
                <div class="mb-3">@Html.LabelFor(m => m.Otp)@Html.TextBoxFor(m => m.Otp, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Otp, "", new { @class = "text-danger" })</div>
                <div class="mb-3">@Html.LabelFor(m => m.NewPassword)@Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })</div>
                <button class="btn btn-modern">Reset Password</button>
            </form>
        </div></div>
    </div>
</div>
@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
