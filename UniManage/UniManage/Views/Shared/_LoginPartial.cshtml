<ul class="navbar-nav ms-lg-auto align-items-lg-center gap-2">
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <li class="nav-item">
        <a class="nav-link nav-pill" title="Manage" href="@Url.Action("Index", "Home")">Hi, @(User.Identity != null ? User.Identity.Name : "User")</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" method="post" action="@Url.Action("Logout", "Account")">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-light btn-sm ms-2">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-outline-light btn-sm" href="@Url.Action("Register", "Account")">Register</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-modern btn-sm px-3" href="@Url.Action("SelectLogin", "Account")">Login</a>
    </li>
}
</ul>
