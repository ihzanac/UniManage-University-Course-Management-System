@model UniManage.ViewModels.SystemUsagePageViewModel
@{
    ViewBag.Title = "System Usage";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-semibold mb-0">System Usage Logs</h5>
    <div class="d-flex gap-2 flex-wrap">
        <span class="total-users-pill">Total Logs: @Model.TotalLogs</span>
        <span class="total-users-pill">Today: @Model.TodayLogs</span>
        <span class="total-users-pill">Unique Users: @Model.UniqueUsers</span>
        <span class="total-users-pill">Showing: @Model.FilteredLogs</span>
    </div>
</div>

<div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex flex-wrap align-items-end gap-2">
        <input type="text"
               name="search"
               value="@Model.SearchTerm"
               class="form-control"
               style="max-width: 360px;"
               placeholder="Search by user name or user id" />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>Search
        </button>
        <a class="btn btn-outline-secondary" href="@Url.Action("SystemUsage")">Clear</a>
    </form>

    <form
          method="post"
          class="d-flex align-items-end"
          onsubmit="return confirm('Are you sure you want to clear all system usage logs?');" action="@Url.Action("ClearSystemUsageLogs")">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash-fill me-1"></i>Clear All Logs
        </button>
    </form>
</div>

@if (!Model.Logs.Any())
{
    <p class="text-secondary mb-0">No usage logs found for this search.</p>
}
else
{
    <div class="table-responsive admin-users-table-wrap">
        <table class="table admin-users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Page</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="fw-semibold">@log.UserName</td>
                        <td>@log.RoleName</td>
                        <td>@log.ActionType</td>
                        <td>@log.ControllerName/@log.ActionName</td>
                        <td>@log.LoggedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
