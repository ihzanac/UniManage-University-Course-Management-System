@model IEnumerable<UniManage.Models.CourseCategory>
@{
    ViewBag.Title = "Manage Categories";
    var categories = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-semibold mb-0">Course Categories</h5>
    <span class="total-users-pill">Total Categories: @categories.Count</span>
</div>
<div class="d-flex gap-2 mb-3 flex-wrap">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="bi bi-plus-circle me-1"></i>Add
    </button>
    <button id="btnOpenCategoryUpdate" type="button" class="btn btn-warning text-white" disabled data-bs-toggle="modal" data-bs-target="#updateCategoryModal">
        <i class="bi bi-pencil-square me-1"></i>Update
    </button>
    <button id="btnOpenCategoryDelete" type="button" class="btn btn-danger" disabled data-bs-toggle="modal" data-bs-target="#deleteCategoryModal">
        <i class="bi bi-trash-fill me-1"></i>Delete
    </button>
</div>

@if (!categories.Any())
{
    <p class="text-secondary mb-0">No categories available yet.</p>
}
else
{
    <div class="table-responsive admin-users-table-wrap">
        <table class="table admin-users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in categories)
                {
                    <tr class="user-selectable-row"
                        data-category-id="@category.Id"
                        data-category-name="@category.Name">
                        <td class="fw-semibold">@category.Name</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" id="addCategoryForm" action="@Url.Action("CreateCategory")">
                    @Html.AntiForgeryToken()
                    <label class="form-label">Category Name</label>
                    <input name="Name" class="form-control" required maxlength="120" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addCategoryForm" class="btn btn-primary">Add Category</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updateCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title">Update Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" id="updateCategoryForm" action="@Url.Action("UpdateCategory")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="updateCategoryId" />
                    <label class="form-label">Category Name</label>
                    <input name="Name" id="updateCategoryName" class="form-control" required maxlength="120" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="updateCategoryForm" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title">Delete Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Are you sure you want to delete this category?</p>
                <p class="mb-0 text-secondary small" id="deleteCategoryLabel"></p>
                <form method="post" id="deleteCategoryForm" class="d-none" action="@Url.Action("DeleteCategory")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteCategoryId" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="deleteCategoryForm" class="btn btn-danger">Delete Category</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rows = document.querySelectorAll(".user-selectable-row");
            const btnUpdate = document.getElementById("btnOpenCategoryUpdate");
            const btnDelete = document.getElementById("btnOpenCategoryDelete");
            const updateCategoryId = document.getElementById("updateCategoryId");
            const updateCategoryName = document.getElementById("updateCategoryName");
            const deleteCategoryId = document.getElementById("deleteCategoryId");
            const deleteCategoryLabel = document.getElementById("deleteCategoryLabel");

            let selected = null;

            function clearSelection() {
                rows.forEach(r => r.classList.remove("active"));
                selected = null;
                btnUpdate.disabled = true;
                btnDelete.disabled = true;
            }

            function selectRow(row) {
                rows.forEach(r => r.classList.remove("active"));
                row.classList.add("active");
                selected = {
                    id: row.dataset.categoryId,
                    name: row.dataset.categoryName || ""
                };
                btnUpdate.disabled = false;
                btnDelete.disabled = false;
            }

            rows.forEach(row => {
                row.addEventListener("click", function () {
                    if (selected && selected.id === row.dataset.categoryId) {
                        clearSelection();
                        return;
                    }
                    selectRow(row);
                });
            });

            btnUpdate.addEventListener("click", function () {
                if (!selected) return;
                updateCategoryId.value = selected.id;
                updateCategoryName.value = selected.name;
            });

            btnDelete.addEventListener("click", function () {
                if (!selected) return;
                deleteCategoryId.value = selected.id;
                deleteCategoryLabel.textContent = selected.name;
            });
        })();
    </script>
}
