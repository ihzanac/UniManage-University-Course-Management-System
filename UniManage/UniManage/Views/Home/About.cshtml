@{
    ViewBag.Title = "About";
}
<div class="card shadow-sm p-2">
    <div class="card-body p-4">
        <h2 class="fw-bold mb-3">About UniManage</h2>
        <p class="text-secondary">UniManage is a full university course management ecosystem built to connect students, lecturers, and academic administrators in one secure digital platform. Our goal is to make education workflows faster, transparent, and easier to manage.</p>
        <p class="text-secondary">From course discovery and enrollment payments to assignment submissions, grading, messaging, and reporting, UniManage provides an end-to-end experience with role-based access control and user-friendly design.</p>
        <hr />
        <div class="row g-3">
            <div class="col-md-4"><div class="p-3 rounded bg-light-subtle">Student-centric dashboards with course and assignment tracking</div></div>
            <div class="col-md-4"><div class="p-3 rounded bg-light-subtle">Lecturer tools for assignment and grading workflows</div></div>
            <div class="col-md-4"><div class="p-3 rounded bg-light-subtle">Admin insights with user, course, and payment monitoring</div></div>
        </div>
    </div>
</div>
