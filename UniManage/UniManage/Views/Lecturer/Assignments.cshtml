@model IEnumerable<UniManage.Models.Assignment>
@{
    ViewBag.Title = "Manage Assignments";
    var courses = (ViewBag.Courses as IEnumerable<UniManage.Models.Course> ?? Enumerable.Empty<UniManage.Models.Course>()).ToList();
    var assignments = Model.OrderByDescending(a => a.DeadlineUtc).ToList();
    TimeZoneInfo sriLankaTimeZone;
    try { sriLankaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Sri Lanka Standard Time"); }
    catch (TimeZoneNotFoundException)
    {
        try { sriLankaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Colombo"); }
        catch (TimeZoneNotFoundException) { sriLankaTimeZone = TimeZoneInfo.Utc; }
    }
    string ToSriLankaTime(DateTime utcValue)
    {
        var safeUtc = DateTime.SpecifyKind(utcValue, DateTimeKind.Utc);
        return TimeZoneInfo.ConvertTimeFromUtc(safeUtc, sriLankaTimeZone).ToString("yyyy-MM-dd hh:mm tt");
    }
    string ToSriLankaInput(DateTime utcValue)
    {
        var safeUtc = DateTime.SpecifyKind(utcValue, DateTimeKind.Utc);
        return TimeZoneInfo.ConvertTimeFromUtc(safeUtc, sriLankaTimeZone).ToString("yyyy-MM-ddTHH:mm");
    }
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-semibold mb-0">Manage Assignments</h5>
    <div class="d-flex align-items-center gap-2">
        <span class="total-users-pill">Total: @assignments.Count</span>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createAssignmentModal">
            <i class="bi bi-plus-circle me-1"></i>Add Assignment
        </button>
    </div>
</div>

@if (!assignments.Any())
{
    <div class="admin-users-table-wrap p-4 text-center">
        <div class="text-secondary mb-2"><i class="bi bi-journal-text fs-3"></i></div>
        <h6 class="fw-semibold mb-1">No assignments created yet</h6>
        <p class="text-secondary mb-0">Create your first assignment with optional downloadable material.</p>
    </div>
}
else
{
    <div class="admin-users-table-wrap">
        <div class="table-responsive">
            <table class="table admin-users-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Title</th>
                        <th>Deadline</th>
                        <th>Material</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in assignments)
                {
                    <tr class="user-selectable-row">
                        <td>@(a.Course != null ? a.Course.Title : "N/A")</td>
                        <td>
                            <div class="fw-semibold">@a.Title</div>
                            <div class="small text-secondary text-truncate" style="max-width:360px;">@a.Description</div>
                        </td>
                        <td>@ToSriLankaTime(a.DeadlineUtc) (SLST)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(a.MaterialFilePath))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("DownloadAssignmentMaterial", new { assignmentId = a.Id })">
                                    <i class="bi bi-download me-1"></i>Download
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary small">No file</span>
                            }
                        </td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-success" href="@Url.Action("Submissions", new { assignmentId = a.Id })">
                                <i class="bi bi-inbox me-1"></i>Submissions
                            </a>
                            <button class="btn btn-sm btn-warning text-white btn-open-update-assignment"
                                    type="button"
                                    data-assignment-id="@a.Id"
                                    data-course-id="@a.CourseId"
                                    data-title="@a.Title"
                                    data-description="@a.Description"
                                    data-deadline="@ToSriLankaInput(a.DeadlineUtc)"
                                    data-material-name="@a.MaterialFileName"
                                    data-bs-toggle="modal"
                                    data-bs-target="#updateAssignmentModal">
                                <i class="bi bi-pencil-square me-1"></i>Update
                            </button>
                            <button class="btn btn-sm btn-danger btn-open-delete-assignment"
                                    type="button"
                                    data-assignment-id="@a.Id"
                                    data-assignment-title="@a.Title"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteAssignmentModal">
                                    <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="createAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content custom-status-modal">
            <form method="post" enctype="multipart/form-data" action="@Url.Action("CreateAssignment")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <select name="CourseId" class="form-select" required>
                                <option value="">Select course</option>
                                @foreach (var c in courses)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Deadline (Sri Lanka Time)</label>
                            <input name="DeadlineUtc" class="form-control" type="datetime-local" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Title</label>
                            <input name="Title" class="form-control" maxlength="200" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" rows="4" required></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Assignment Material (Optional)</label>
                            <input type="file" name="MaterialFile" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx" />
                            <div class="form-text">Allowed: PDF, Word, PowerPoint (max 10MB).</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i>Create Assignment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="updateAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content custom-status-modal">
            <form method="post" enctype="multipart/form-data" action="@Url.Action("UpdateAssignment")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="updateAssignmentId" />
                <div class="modal-header">
                    <h5 class="modal-title">Update Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <select name="CourseId" class="form-select" id="updateCourseId" required>
                                <option value="">Select course</option>
                                @foreach (var c in courses)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Deadline (Sri Lanka Time)</label>
                            <input name="DeadlineUtc" class="form-control" type="datetime-local" id="updateDeadline" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Title</label>
                            <input name="Title" class="form-control" id="updateTitle" maxlength="200" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" id="updateDescription" rows="4" required></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Replace Assignment Material (Optional)</label>
                            <input type="file" name="MaterialFile" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx" />
                            <div class="form-text">Allowed: PDF, Word, PowerPoint (max 10MB). Leave empty to keep current file.</div>
                            <div class="small text-secondary mt-2">Current file: <span id="updateCurrentMaterial">No file</span></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-white">
                        <i class="bi bi-check2-circle me-1"></i>Update Assignment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-status-modal">
            <form method="post" action="@Url.Action("DeleteAssignment")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteAssignmentId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Are you sure you want to delete this assignment?</p>
                    <p class="mb-0 text-secondary small" id="deleteAssignmentTitle"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const deleteModal = document.getElementById("deleteAssignmentModal");
            const hiddenIdInput = document.getElementById("deleteAssignmentId");
            const titleLabel = document.getElementById("deleteAssignmentTitle");
            if (deleteModal && hiddenIdInput && titleLabel) {
                document.querySelectorAll(".btn-open-delete-assignment").forEach(btn => {
                    btn.addEventListener("click", function () {
                        hiddenIdInput.value = this.getAttribute("data-assignment-id") || "";
                        titleLabel.textContent = this.getAttribute("data-assignment-title") || "";
                    });
                });
            }

            const updateModal = document.getElementById("updateAssignmentModal");
            const updateId = document.getElementById("updateAssignmentId");
            const updateCourseId = document.getElementById("updateCourseId");
            const updateTitle = document.getElementById("updateTitle");
            const updateDescription = document.getElementById("updateDescription");
            const updateDeadline = document.getElementById("updateDeadline");
            const updateCurrentMaterial = document.getElementById("updateCurrentMaterial");
            if (updateModal && updateId && updateCourseId && updateTitle && updateDescription && updateDeadline && updateCurrentMaterial) {
                document.querySelectorAll(".btn-open-update-assignment").forEach(btn => {
                    btn.addEventListener("click", function () {
                        updateId.value = this.getAttribute("data-assignment-id") || "";
                        updateCourseId.value = this.getAttribute("data-course-id") || "";
                        updateTitle.value = this.getAttribute("data-title") || "";
                        updateDescription.value = this.getAttribute("data-description") || "";
                        updateDeadline.value = this.getAttribute("data-deadline") || "";
                        updateCurrentMaterial.textContent = this.getAttribute("data-material-name") || "No file";
                    });
                });
            }
        })();
    </script>
}
