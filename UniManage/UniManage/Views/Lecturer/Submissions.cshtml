@model IEnumerable<UniManage.Models.AssignmentSubmission>
@{
    ViewBag.Title = "Submissions";
    var submissions = Model.OrderByDescending(s => s.SubmittedAtUtc).ToList();
    var assignmentId = (int)(ViewBag.AssignmentId ?? 0);
    var searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
}
<style>
    .submissions-table {
        table-layout: auto;
        width: 100%;
    }

    .submissions-table td,
    .submissions-table th {
        vertical-align: middle;
    }

    .submissions-student-email {
        overflow-wrap: anywhere;
    }

    .submission-status-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .36rem .72rem;
        font-size: .76rem;
        font-weight: 700;
    }

    .submission-status-ontime {
        background: #198754;
        color: #fff;
    }

    .submission-status-late {
        background: #dc3545;
        color: #fff;
    }

    @@media (max-width: 992px) {
        .submissions-table th,
        .submissions-table td {
            white-space: normal;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h5 class="fw-semibold mb-0">Assignment Submissions</h5>
    <span class="total-users-pill">Total Submissions: @submissions.Count</span>
</div>

<form method="get" class="admin-users-table-wrap p-3 mb-3" action="@Url.Action("Submissions")">
    <input type="hidden" name="assignmentId" value="@assignmentId" />
    <div class="row g-2 align-items-end">
        <div class="col-lg-9">
            <label class="form-label mb-1">Search Submissions</label>
            <input type="text"
                   name="search"
                   class="form-control"
                   value="@searchTerm"
                   placeholder="Search by student name or email..." />
        </div>
        <div class="col-lg-3 d-grid">
            <button class="btn btn-primary">
                <i class="bi bi-search me-1"></i>Search
            </button>
        </div>
    </div>
</form>

@if (!submissions.Any())
{
    <div class="admin-users-table-wrap p-4 text-center">
        <div class="text-secondary mb-2"><i class="bi bi-inbox fs-3"></i></div>
        <h6 class="fw-semibold mb-1">No submissions available</h6>
        <p class="text-secondary mb-0">Student submissions will appear here after they upload assignment files.</p>
    </div>
}
else
{
    <div class="admin-users-table-wrap">
        <div class="table-responsive">
            <table class="table admin-users-table submissions-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Submission File</th>
                        <th>Submitted At (UTC)</th>
                        <th>Submission Status</th>
                        <th>Grade & Feedback</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in submissions)
                {
                    <tr class="user-selectable-row">
                        <td>
                            <div class="fw-semibold">@((s.Student != null && !string.IsNullOrWhiteSpace(s.Student.FullName)) ? s.Student.FullName : "Student")</div>
                            <div class="small text-secondary submissions-student-email">@(s.Student != null ? s.Student.Email : string.Empty)</div>
                        </td>
                        <td>
                            <a href="@s.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-download me-1"></i>Download
                            </a>
                        </td>
                        <td>@s.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            @if (s.Status == UniManage.Models.AssignmentSubmissionStatus.Late)
                            {
                                <span class="submission-status-badge submission-status-late">
                                    Late Submission
                                </span>
                            }
                            else
                            {
                                <span class="submission-status-badge submission-status-ontime">
                                    On Time
                                </span>
                            }
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm @(s.Grade is null ? "btn-success" : "btn-warning text-white") btn-open-grade-modal"
                                    data-bs-toggle="modal"
                                    data-bs-target="#gradeModal"
                                    data-submission-id="@s.Id"
                                    data-student-name="@((s.Student != null && !string.IsNullOrWhiteSpace(s.Student.FullName)) ? s.Student.FullName : "Student")"
                                    data-score="@(s.Grade != null ? s.Grade.Score : 0)"
                                    data-feedback="@(s.Grade != null ? s.Grade.Feedback : "")">
                                <i class="bi bi-pencil-square me-1"></i>@(s.Grade is null ? "Add Grade" : "Update Grade")
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="gradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content custom-status-modal">
            <form method="post" action="@Url.Action("SaveGrade")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SubmissionId" id="gradeSubmissionId" />
                <div class="modal-header">
                    <h5 class="modal-title">Add Grade</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Student: <strong id="gradeStudentName">Student</strong></p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Score (0-100)</label>
                            <input name="Score" id="gradeScore" class="form-control" type="number" step="0.01" min="0" max="100" required />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Feedback</label>
                            <textarea name="Feedback" id="gradeFeedback" class="form-control" rows="4" placeholder="Add feedback for student..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check2-circle me-1"></i>Save Grade
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const gradeSubmissionId = document.getElementById("gradeSubmissionId");
            const gradeStudentName = document.getElementById("gradeStudentName");
            const gradeScore = document.getElementById("gradeScore");
            const gradeFeedback = document.getElementById("gradeFeedback");
            const modalTitle = document.querySelector("#gradeModal .modal-title");

            document.querySelectorAll(".btn-open-grade-modal").forEach(btn => {
                btn.addEventListener("click", function () {
                    const submissionId = this.getAttribute("data-submission-id") || "";
                    const studentName = this.getAttribute("data-student-name") || "Student";
                    const score = this.getAttribute("data-score") || "0";
                    const feedback = this.getAttribute("data-feedback") || "";
                    const isUpdate = this.textContent.includes("Update");

                    gradeSubmissionId.value = submissionId;
                    gradeStudentName.textContent = studentName;
                    gradeScore.value = score;
                    gradeFeedback.value = feedback;
                    if (modalTitle) {
                        modalTitle.textContent = isUpdate ? "Update Grade" : "Add Grade";
                    }
                });
            });
        })();
    </script>
}
